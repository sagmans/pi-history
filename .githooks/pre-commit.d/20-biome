#!/bin/sh
# Runs Biome on the staged files, as staged: the content is read from the
# index into a temporary tree, never from the working tree.
set -eu

# Shared helpers (staged_git, pushed_shas, at_sha, darwin_only) from the dotf
# dispatcher, which also scrubs git's repository-local variables first.
# shellcheck source=/dev/null
. "${HOOK_HELPERS:?HOOK_HELPERS is not set: run this hook through the dotf git hooks dispatcher}"
# Repository helpers, loaded relative to this script (the reviewed copy).
# shellcheck source=../_lib/staged.sh
. "$(dirname -- "$0")/../_lib/staged.sh"

files=$(staged_git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n') || exit 1
[ -n "$files" ] || exit 0
staged_tree
cd "$st_tree"
# No .git in the temporary tree, so Biome's VCS integration is off; only the
# staged paths are passed, so the ignore file has nothing to filter.
printf '%s\n' "$files" | tr '\n' '\0' |
	xargs -0 ./node_modules/.bin/biome check --vcs-enabled=false --no-errors-on-unmatched --files-ignore-unknown=true
