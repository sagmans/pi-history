#!/usr/bin/env bash
# Runs `npm run verify:ci` (audit, Biome, typecheck, tests), shell checks, and
# a pack dry-run on each pushed commit. The Pi host compatibility matrix runs
# in 30-pi-compat.
set -euo pipefail

readonly INSTALL_TIMEOUT_SECONDS=300
readonly SUITE_TIMEOUT_SECONDS=600

for tool in npm shellcheck shfmt; do
	command -v "$tool" >/dev/null || {
		echo "pre-push: $tool is missing" >&2
		exit 1
	}
done

checks() {
	run_step 'npm verify:ci' "$SUITE_TIMEOUT_SECONDS" npm run verify:ci || return 1
	run_step 'shell lint and format' "$SUITE_TIMEOUT_SECONDS" bash scripts/lint-shell.sh || return 1
	run_step 'npm pack dry run' "$SUITE_TIMEOUT_SECONDS" npm pack --dry-run --ignore-scripts >/dev/null || return 1
}

# Helpers (staged_git, pushed_shas, at_sha, run_step, darwin_only) from .githooks/lib.
# shellcheck source=.githooks/lib/helpers.sh
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"

top=$(git rev-parse --show-toplevel)
# A temporary worktree has no dependencies: install them from that commit's
# lockfile (never resolved; lifecycle scripts stay off). In place, the clone's
# install is used.
install_deps() {
	[[ "$(pwd -P)" != "$(CDPATH='' cd -- "$top" && pwd -P)" ]] || return 0
	[[ -f package-lock.json ]] || {
		echo "pre-push: package-lock.json missing" >&2
		return 1
	}
	run_step 'npm ci' "$INSTALL_TIMEOUT_SECONDS" npm ci --ignore-scripts --no-audit --no-fund >/dev/null || return 1
}

# at_sha runs this with set -e off, so every step returns on failure.
run_at() {
	install_deps || return 1
	checks || return 1
}

# Each pushed commit is tested as pushed: in place when it is a clean HEAD,
# otherwise in a temporary worktree. A for loop, never `| while`, so a failure
# blocks the push.
shas=$(pushed_shas <"$HOOK_STDIN_FILE") || exit 1
for pp_commit in $shas; do
	echo "pre-push: $(basename -- "$0"): checking $pp_commit" >&2
	if ! at_sha "$pp_commit" run_at; then
		echo "pre-push: $(basename -- "$0"): checks failed for $pp_commit" >&2
		exit 1
	fi
done
